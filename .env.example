DATABASE_URL=postgresql://postgres:postgres@localhost:5432/matchscore?schema=public
FOOTBALL_API_KEY=
FOOTBALL_API_PROVIDER=api-football
OPENFOOTBALL_LEAGUES=fr.1,en.1,de.1,es.1,it.1
# Explicit opt-in, development only; production never serves mock data.
MATCHSCORE_DEMO=false
CRON_SECRET=
ADMIN_SECRET=
# Production: the actual HTTPS origin, without a path. Required before public indexing.
NEXT_PUBLIC_SITE_URL=https://proba-match.vercel.app
# Set preview/staging on non-public environments outside Vercel (VERCEL_ENV is automatic there).
APP_ENV=development
# Daily quota reserved for background synchronization
FOOTBALL_DAILY_BUDGET=90
FOOTBALL_LEAGUES=61,39,140,135,78,2
# Optional public publisher contact displayed on /contact
CONTACT_EMAIL=

# Public legal details: genuine values only; never put passwords in these fields.
LEGAL_EDITOR_NAME=
LEGAL_PUBLICATION_DIRECTOR=
LEGAL_EDITOR_ADDRESS=
LEGAL_REGISTRATION=
LEGAL_HOST_NAME=Vercel
LEGAL_HOST_ADDRESS=
# Verified retention policy and procedure for exercising rights (free text).
LEGAL_LOG_RETENTION=
# Optional Web Vitals: off by default; emits first-party aggregated technical logs.
NEXT_PUBLIC_WEB_VITALS_ENABLED=false
